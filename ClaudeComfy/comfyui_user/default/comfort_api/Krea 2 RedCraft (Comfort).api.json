{
 "unet": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "Krea2\\redcraftHybridH3Krea2t_30Krea2_fp8.safetensors",
   "weight_dtype": "default"
  }
 },
 "enh": {
  "class_type": "ComfyUI-Krea2T-Enhancer",
  "inputs": {
   "model": [
    "unet",
    0
   ],
   "enabled": true,
   "strength": 1.5,
   "debug": false
  }
 },
 "clip": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "Qwen3VL4B\\qwen3-vl-4b-heretic_fp8_e4m3fn.safetensors",
   "type": "krea2",
   "device": "default"
  }
 },
 "vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "qwen_image_vae.safetensors"
  }
 },
 "pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": "describe the image here",
   "clip": [
    "clip",
    0
   ]
  },
  "_meta": {
   "title": "Prompt"
  }
 },
 "neg": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "pos",
    0
   ]
  }
 },
 "lat": {
  "class_type": "EmptyLatentImage",
  "inputs": {
   "width": 1376,
   "height": 768,
   "batch_size": 1
  },
  "_meta": {
   "title": "Size"
  }
 },
 "s1": {
  "class_type": "ClownsharKSampler_Beta",
  "inputs": {
   "seed": 1,
   "sampler_mode": "standard",
   "bongmath": true,
   "model": [
    "enh",
    0
   ],
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "eta": 0,
   "sampler_name": "linear/euler",
   "scheduler": "simple",
   "steps": 8,
   "steps_to_run": -1,
   "denoise": 1.0,
   "cfg": 1,
   "latent_image": [
    "lat",
    0
   ]
  }
 },
 "s2": {
  "class_type": "ClownsharKSampler_Beta",
  "inputs": {
   "seed": 1,
   "sampler_mode": "standard",
   "bongmath": true,
   "model": [
    "enh",
    0
   ],
   "positive": [
    "pos",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "eta": 0.9,
   "sampler_name": "exponential/res_2s",
   "scheduler": "bong_tangent",
   "steps": 8,
   "steps_to_run": 2,
   "denoise": 0.2,
   "cfg": 1,
   "latent_image": [
    "s1",
    0
   ]
  }
 },
 "dec": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "s2",
    1
   ],
   "vae": [
    "vae",
    0
   ]
  }
 },
 "out": {
  "class_type": "PreviewImage",
  "inputs": {
   "images": [
    "dec",
    0
   ]
  }
 }
}